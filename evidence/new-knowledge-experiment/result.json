  "queries": [
    {
      "case_id": "beijing_materials",
      "question": "身份证期满换领需要哪些材料？",
      "result": {
        "mode": "public_candidate_preview",
        "formally_published": false,
        "business_conclusion_status": "PAUSED_UNREVIEWED",
        "citations": [
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "locator": "正文段落2",
            "quote": "国家决定换发新一代居民身份证、居民身份证有效期满、公民姓名变更或者证件严重损坏不能辨认；居民身份证登记项目出现错误的，公民应当申请换领《居民身份证》。",
            "text_sha256": "1268ef4fa8fadc8a9c2f7314e8804500275dc45c61726408828c87655598106e",
            "published_at": "2025-03-03",
            "effective_from": null,
            "effective_to": null,
            "current_applicability": "unknown"
          },
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "locator": "正文段落24",
            "quote": "提示：本市户籍居民符合以下条件可在网上办理居民身份证损坏换领业务：",
            "text_sha256": "d23189d9908b8f482b0a9216bf7d1c37c3e299cc82dad7d767818dbabee17867",
            "published_at": "2025-03-03",
            "effective_from": null,
            "effective_to": null,
            "current_applicability": "unknown"
          },
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "locator": "正文段落4",
            "quote": "申领人持原《居民身份证》现场办理；未满十六周岁的公民，申请换领《居民身份证》的，由监护人带领其现场办理，并提供监护人《居民身份证》原件。",
            "text_sha256": "6eb06147860cee712a13a1d072ed71eaa784cebefcba12bfa7c93f726f1738ec",
            "published_at": "2025-03-03",
            "effective_from": null,
            "effective_to": null,
            "current_applicability": "unknown"
          },
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "locator": "正文段落10",
            "quote": "申领人持原《居民身份证》现场办理，现场进行指纹采集、人像采集等工作，并领取凭证。自受理之日起10个工作日发放证件。申请人持领取凭证领取身份证。领取新证时，须交回旧证。",
            "text_sha256": "57d4aabf3c70cb421b90992b49b7b4a72f5c815267e6d995ef05bb2fd110002c",
            "published_at": "2025-03-03",
            "effective_from": null,
            "effective_to": null,
            "current_applicability": "unknown"
          },
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "locator": "正文段落21",
            "quote": "《国家发展改革委、财政部关于居民身份证收费标准及有关问题的通知》(特急发改价格[2003]2322号)；",
            "text_sha256": "933289de4a59300eff1f4043bfd033ae7bb349a4454e95375d94317e7cd9fdc8",
            "published_at": "2025-03-03",
            "effective_from": null,
            "effective_to": null,
            "current_applicability": "unknown"
          }
        ],
        "region": "北京市",
        "matter": "resident-id-renewal",
        "source_scope_limits": [
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "limits": "京籍居民换领；未成年人要求保留。网办提示仅指损坏换领，须连同户籍、年龄、五年内办证/照片及指纹条件理解，不推为到期网办或河南材料标准。页面日期不是施行日。"
          }
        ],
        "source_context": [
          {
            "source_id": "BJ-ID-RENEWAL-2025",
            "url": "https://www.beijing.gov.cn/fuwu/bmfw/bmzt/sfz/blzn/201806/t20180622_1857526.html",
            "revision_id": "rev-6c473588ae861c51c65bb11a",
            "original_sha256": "78bbf800be6fd82212c137b697ac0d80b195cdf5da1e2e3ef7a6203b37201cda",
            "selected_clauses": [
              {
                "locator": "正文段落2",
                "category": "identity",
                "text": "国家决定换发新一代居民身份证、居民身份证有效期满、公民姓名变更或者证件严重损坏不能辨认；居民身份证登记项目出现错误的，公民应当申请换领《居民身份证》。"
              },
              {
                "locator": "正文段落4",
                "category": "identity",
                "text": "申领人持原《居民身份证》现场办理；未满十六周岁的公民，申请换领《居民身份证》的，由监护人带领其现场办理，并提供监护人《居民身份证》原件。"
              },
              {
                "locator": "正文段落6",
                "category": "procedure",
                "text": "可就近选择任意户籍派出所。"
              },
              {
                "locator": "正文段落8",
                "category": "procedure",
                "text": "城镇地区派出所户籍接待室每周七天对外办公，郊区分局户政大厅周一至周五办公，农村地区派出所双休日实行预约办事制度。"
              },
              {
                "locator": "正文段落10",
                "category": "identity",
                "text": "申领人持原《居民身份证》现场办理，现场进行指纹采集、人像采集等工作，并领取凭证。自受理之日起10个工作日发放证件。申请人持领取凭证领取身份证。领取新证时，须交回旧证。"
              },
              {
                "locator": "正文段落12",
                "category": "procedure",
                "text": "未满十六周岁的公民，有效期五年；"
              },
              {
                "locator": "正文段落13",
                "category": "procedure",
                "text": "十六周岁至二十五周岁，有效期十年；"
              },
              {
                "locator": "正文段落14",
                "category": "procedure",
                "text": "二十六周岁至四十五周岁，有效期二十年；"
              },
              {
                "locator": "正文段落15",
                "category": "procedure",
                "text": "四十六周岁以上的，长期有效。"
              },
              {
                "locator": "正文段落17",
                "category": "procedure",
                "text": "自受理之日起10个工作日发放证件。"
              },
              {
                "locator": "正文段落19",
                "category": "procedure",
                "text": "损坏换领每证40元、其他原因换领证件每证20元。"
              },
              {
                "locator": "正文段落21",
                "category": "identity",
                "text": "《国家发展改革委、财政部关于居民身份证收费标准及有关问题的通知》(特急发改价格[2003]2322号)；"
              },
              {
                "locator": "正文段落23",
                "category": "identity",
                "text": "《中华人民共和国居民身份证法》"
              },
              {
                "locator": "正文段落24",
                "category": "identity",
                "text": "提示：本市户籍居民符合以下条件可在网上办理居民身份证损坏换领业务："
              },
              {
                "locator": "正文段落25",
                "category": "identity",
                "text": "本市户籍居民，16周岁以上，5年之内办理过居民身份证，5年之内采集过居民身份证照片，至少有一枚指纹注册成功。"
              }
