  "assets": [
    {
      "id": "asset-core",
      "source_url": "synthetic://gov-demo/core",
      "title": "模拟通行卡资料-core",
      "revision": "rev-core-v1",
      "data_class": "synthetic",
      "text": "【工程模拟资料，不是真实政务政策】\n模拟市通行卡到期换领分为申请和领取两个环节。\n成年本人到期换领可进入成年本人演练分支。\n未成年人本人情况单独分支，本模拟资料尚未提供其办事清单。\n成年本人演练分支内，申请时需提交模拟申请表。\n成年本人演练分支内，申请时应交验演练旧卡。\n成年本人演练分支内，领取新卡时交回演练旧卡。\n成年本人演练分支内，领取时需出示模拟领取凭条。\n演练旧卡又称旧演练卡，本演练中为同一材料。\n本模拟规则仅供模拟市演练，时间区间为2026-01-01至2027-01-01（不含后者）。\n",
      "sha256": "282d0bf70af2a9c490c2062a8f96868d8428018505d064c8c786314b8aad39aa"
    },
    {
      "id": "asset-exception",
      "source_url": "synthetic://gov-demo/exception",
      "title": "模拟通行卡资料-exception",
      "revision": "rev-exception-v1",
      "data_class": "synthetic",
      "text": "【工程模拟资料，不是真实政务政策】\n成年本人演练分支中，可验证的模拟电子申请表替代模拟纸质申请表；无法验证时仍需纸质表。\n电子表是否可验证不清楚时，不得推定有或没有替代资格。\n",
      "sha256": "f8730073436dab4e02cb17d1cfd633793e2c007b36db55790e461e84eeca5ab1"
    },
    {
      "id": "asset-unconfirmed",
      "source_url": "synthetic://gov-demo/unconfirmed",
      "title": "模拟通行卡资料-unconfirmed",
      "revision": "rev-unconfirmed-v1",
      "data_class": "synthetic",
      "text": "【工程模拟资料，不是真实政务政策】\n某演练资料提到申请时可出示模拟居住证明，该说法是否适用于模拟市尚未确认。\n另有演练资料把演练旧卡简称为旧证，该别名尚未确认。\n",
      "sha256": "c80e5bf6646e8b2add7d05b5336e3cdbdd699dd783a48b7cf3eedeb24c514df9"
    }
  ],
