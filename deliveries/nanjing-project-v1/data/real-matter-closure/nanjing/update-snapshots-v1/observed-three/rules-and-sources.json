          "locator": "正文段落36",
          "category": "procedure",
          "text": "联系我们",
          "text_sha256": "c044f887b35d4c3a2e4f58b8f3d074b0cc703153a132543070e06da91a96b424"
        },
        {
          "segment_id": "NJ-POLICE-FAQ-2025-P37",
          "locator": "正文段落37",
          "category": "procedure",
          "text": "主办单位：南京市公安局 支持单位：南京市城市数字治理中心",
          "text_sha256": "bc2f4a0d5487150d709f7cf43c4a3181a47897049276e89b526fb8bf6a1e3011"
        },
        {
