  "facts": [
    {
      "id": "governance_scope",
      "locator": "第二条",
      "revision": "rev-2a3287697e1e638806bd4c91",
      "original_sha256": "23a107b9c0d0668476d6b6f97f61e3163d79abe580e865584061471695ea0fc3",
      "start": 4,
      "end": 43,
      "quote": "本省行政区域内行政规范性文件的制定、备案审查以及相关监督管理工作，适用本办法。",
      "quote_sha256": "bd42815d064554265ecb881e4f40394927691a8f6dfeeda1c7ec3e24b03c4ac1"
    },
    {
      "id": "stated_expiry",
      "locator": "第二十五条",
      "revision": "rev-2a3287697e1e638806bd4c91",
      "original_sha256": "23a107b9c0d0668476d6b6f97f61e3163d79abe580e865584061471695ea0fc3",
      "start": 0,
      "end": 69,
      "quote": "第二十五条 行政规范性文件的名称冠以“暂行”“试行”或者涉及的内容属于阶段性工作的，应当载明有效期。有效期届满的，行政规范性文件自动失效。",
      "quote_sha256": "b5668b35589d05b30faad0d00d66bf4d85b951bd90e2a5fbec65212b3cc4abd9"
    },
    {
      "id": "conflict_coordination",
      "locator": "第三十五条",
      "revision": "rev-2a3287697e1e638806bd4c91",
      "original_sha256": "23a107b9c0d0668476d6b6f97f61e3163d79abe580e865584061471695ea0fc3",
      "start": 0,
      "end": 114,
      "quote": "第三十五条 县级以上人民政府司法行政部门对报送备案的行政规范性文件进行审查时，发现行政规范性文件之间相互矛盾的，应当进行协调。经协调达成一致意见的，由有关制定机关自行纠正；达不成一致意见的，应当提出处理意见，报本级人民政府决定。",
      "quote_sha256": "ff3bc35073ca3113c77887981503662b8ff906800478a4e3cf18919b639c3345"
    },
    {
      "id": "periodic_cleanup",
      "locator": "第四十条",
      "revision": "rev-2a3287697e1e638806bd4c91",
      "original_sha256": "23a107b9c0d0668476d6b6f97f61e3163d79abe580e865584061471695ea0fc3",
      "start": 5,
      "end": 25,
      "quote": "行政规范性文件应当每隔2年进行一次清理。",
      "quote_sha256": "5be3fb4b9f6b884a8d625c4a513a323439933be95f0f939f77a903acfb1a7a59"
    }
  ],
  "bounded_inferences": [
    {
      "id": "no_two_year_expiry_from_cleanup",
      "basis": [
        "stated_expiry",
        "periodic_cleanup"
      ],
      "finding": "第25条要求试行文件载明有效期、期满自动失效，第40条另规定每隔2年清理；这两条不能直接推出所有试行文件一律2年，或豫公通〔2022〕77号于2024-09-01失效。",
      "effectivity_decision": false
    },
    {
