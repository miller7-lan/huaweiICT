{
  "schema_version": 1,
  "phase": "M2",
  "collection_strategy": "small_traceable_preview_first_then_review_and_expand",
  "dimensions": {
    "source": ["source_id", "document_type", "issuer", "url", "sha256"],
    "region": ["national", "province", "city", "district", "receiving_office_scope"],
    "matter": ["matter_id", "official_matter_code", "included_branch", "excluded_branch"],
    "material_category": {
      "identity": "身份材料",
      "household": "户籍材料",
      "eligibility": "适用条件",
      "procedure": "办理流程"
    },
    "applicability": ["age_branch", "local_or_nonlocal", "application_reason", "required_or_conditional_or_alternative", "processing_stage"],
    "knowledge_version": ["version_id", "source_manifest_sha256", "published_at", "effective_from", "retrieved_at", "review_status"]
  },
  "review_states": ["pending_business_review", "reviewed_for_scope", "superseded", "rejected"],
