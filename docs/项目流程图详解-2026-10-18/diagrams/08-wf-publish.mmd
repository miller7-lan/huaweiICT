flowchart TD
    nselect["选择待审包与对象"]
    nbasis["记录逐对象复核依据"]
    nhead["发布前核对当前头及来源"]
    nactor["核对同一发布人已接受"]
    nmerge["合并选中的知识记录"]
    nvalid["生成传递依赖复核哈希"]
    nswitch["事务内切换wf_head"]
    nrollback["显式回退历史版本"]
    nselect -->|"复核"| nbasis
    nbasis -->|"人工发起发布"| nhead
    nhead -->|"校验通过"| nactor
    nactor -->|"通过"| nmerge
    nmerge -->|"候选新快照"| nvalid
    nvalid -->|"完整验证成功"| nswitch
    nswitch -->|"需要回退时"| nrollback
    nrollback -->|"下次发布重新校验"| nhead
    classDef gate fill:#fff4d8,stroke:#a56b13
    classDef stop fill:#ffeded,stroke:#b74343
    class nhead,nactor,nvalid gate
