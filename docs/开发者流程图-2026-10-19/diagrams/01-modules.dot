fetch [id="01-modules-fetch", label=<<B>knowledge_fetch.worker_once</B><BR/><FONT POINT-SIZE="10">自然调度的采集任务；robots、正文解析、去重及重试<BR ALIGN="LEFT"/>。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">knowledge_fetch.py:503</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/knowledge_fetch.py:worker_once"];
