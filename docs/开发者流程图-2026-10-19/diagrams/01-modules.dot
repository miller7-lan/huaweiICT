web [id="01-modules-web", label=<<B>decision.server.create_app</B><BR/><FONT POINT-SIZE="10">8780网页与MCP入口；认证、参数检查、响应封装。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">server.py:29</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/server.py:create_app"];
form [id="01-modules-form", label=<<B>intake.GuidedForm</B><BR/><FONT POINT-SIZE="10">本机会话草稿；版本、AI格式核查、人工确认后进入Wo<BR ALIGN="LEFT"/>rkflow.query。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">intake.py:89</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/intake.py:GuidedForm"];
wf [id="01-modules-wf", label=<<B>workflow.Workflow</B><BR/><FONT POINT-SIZE="10">咨询编排、分阶段MCP状态、模拟更新、逐项复核和发<BR ALIGN="LEFT"/>布。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">workflow.py:49</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/workflow.py:Workflow"];
service [id="01-modules-service", label=<<B>service.DecisionService</B><BR/><FONT POINT-SIZE="10">prepare固定事实与依赖；finalize重读当前暂停并分<BR ALIGN="LEFT"/>流结果。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">service.py:49</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/service.py:DecisionService"];
logic [id="01-modules-logic", label=<<B>logic.evaluate</B><BR/><FONT POINT-SIZE="10">严格类型及true / false / unknown规则；不靠模型猜<BR ALIGN="LEFT"/>未知事实。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">logic.py:104</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/logic.py:evaluate"];
wired [id="01-modules-wired", label=<<B>connections.WiredRoles.invoke</B><BR/><FONT POINT-SIZE="10">当前调用prepare登记路由，再进入OfflineRoles；这<BR ALIGN="LEFT"/>里不会自动发模型请求。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">connections.py:210</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/connections.py:WiredRoles.invoke"];
offline [id="01-modules-offline", label=<<B>adapters.OfflineRoles.invoke</B><BR/><FONT POINT-SIZE="10">白名单检查后执行action()；remote_calls=0。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">adapters.py:31</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/decision/adapters.py:OfflineRoles.invoke"];
