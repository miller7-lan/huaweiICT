preview [id="01-modules-preview", label=<<B>Preview / RegionalPreview</B><BR/><FONT POINT-SIZE="10">8781/8782独立public预览；预算与来源绑定后才调用<BR ALIGN="LEFT"/>专用LiveVerifier。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">public_preview.py:203</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/public_preview.py:Preview"];
cloud [id="01-modules-cloud", label=<<B>EnglishJevProvider.evaluate</B><BR/><FONT POINT-SIZE="10">DeepSeek英译→Jev；保留原文和回执；独立于工作台<BR ALIGN="LEFT"/>离线角色。</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">jev_translation.py:114</FONT>>, fillcolor="#edf4ff", color="#3d6fa6", tooltip="src/gov_mcp/jev_translation.py:EnglishJevProvider.evaluate"];
