digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.6", splines=polyline, fontname="Microsoft YaHei"];
node [shape=box, style="rounded,filled", width=5.8, fontname="Microsoft YaHei", fontsize=12, margin="0.18,0.16"];
edge [fontname="Microsoft YaHei", fontsize=10, color="#708299", arrowsize=0.75];
sites [id="06-registry-data-sites", label=<<B>sites</B><BR/><FONT POINT-SIZE="10">id TEXT PRIMARY KEY<BR ALIGN="LEFT"/>config TEXT NOT NULL<BR ALIGN="LEFT"/>next_check REAL NOT NULL DEFAULT 0<BR ALIGN="LEFT"/>last_success REAL<BR ALIGN="LEFT"/>last_request REAL<BR ALIGN="LEFT"/>failures INTEGER NOT NULL DEFAULT 0<BR ALIGN="LEFT"/>paused_reason TEXT</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
documents [id="06-registry-data-documents", label=<<B>documents</B><BR/><FONT POINT-SIZE="10">id TEXT PRIMARY KEY<BR ALIGN="LEFT"/>site_id TEXT NOT NULL REFERENCES sites(id)<BR ALIGN="LEFT"/>url TEXT NOT NULL<BR ALIGN="LEFT"/>title TEXT NOT NULL<BR ALIGN="LEFT"/>UNIQUE(site_id,url)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
revisions [id="06-registry-data-revisions", label=<<B>revisions</B><BR/><FONT POINT-SIZE="10">id TEXT PRIMARY KEY<BR ALIGN="LEFT"/>document_id TEXT NOT NULL REFERENCES documents(id)<BR ALIGN="LEFT"/>sha256 TEXT NOT NULL<BR ALIGN="LEFT"/>body_sha256 TEXT NOT NULL<BR ALIGN="LEFT"/>metadata TEXT NOT NULL<BR ALIGN="LEFT"/>created_at REAL NOT NULL<BR ALIGN="LEFT"/>state TEXT NOT NULL DEFAULT &#x27;pending_review&#x27;<BR ALIGN="LEFT"/>UNIQUE(document_id,body_sha256,metadata)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
chunks [id="06-registry-data-chunks", label=<<B>chunks</B><BR/><FONT POINT-SIZE="10">revision_id TEXT NOT NULL REFERENCES revisions(id)<BR ALIGN="LEFT"/>ordinal INTEGER NOT NULL<BR ALIGN="LEFT"/>locator TEXT NOT NULL<BR ALIGN="LEFT"/>category TEXT NOT NULL<BR ALIGN="LEFT"/>text TEXT NOT NULL<BR ALIGN="LEFT"/>PRIMARY KEY(revision_id,ordinal)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
reviews [id="06-registry-data-reviews", label=<<B>reviews</B><BR/><FONT POINT-SIZE="10">revision_id TEXT PRIMARY KEY REFERENCES revisions(id)<BR ALIGN="LEFT"/>reviewer TEXT NOT NULL<BR ALIGN="LEFT"/>digest TEXT NOT NULL<BR ALIGN="LEFT"/>reviewed_at REAL NOT NULL</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
exclusions [id="06-registry-data-exclusions", label=<<B>exclusions</B><BR/><FONT POINT-SIZE="10">revision_id TEXT PRIMARY KEY REFERENCES revisions(id)<BR ALIGN="LEFT"/>reviewer TEXT NOT NULL<BR ALIGN="LEFT"/>reason TEXT NOT NULL<BR ALIGN="LEFT"/>digest TEXT NOT NULL<BR ALIGN="LEFT"/>reviewed_at REAL NOT NULL</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
versions [id="06-registry-data-versions", label=<<B>versions</B><BR/><FONT POINT-SIZE="10">id TEXT PRIMARY KEY<BR ALIGN="LEFT"/>scope TEXT NOT NULL<BR ALIGN="LEFT"/>members TEXT NOT NULL<BR ALIGN="LEFT"/>parent TEXT<BR ALIGN="LEFT"/>created_at REAL NOT NULL<BR ALIGN="LEFT"/>state TEXT NOT NULL DEFAULT &#x27;candidate&#x27;</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
heads [id="06-registry-data-heads", label=<<B>heads</B><BR/><FONT POINT-SIZE="10">scope TEXT PRIMARY KEY<BR ALIGN="LEFT"/>version_id TEXT NOT NULL REFERENCES versions(id)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
snapshot_evaluations [id="06-registry-data-snapshot_evaluations", label=<<B>snapshot_evaluations</B><BR/><FONT POINT-SIZE="10">id TEXT PRIMARY KEY<BR ALIGN="LEFT"/>version_id TEXT NOT NULL REFERENCES versions(id)<BR ALIGN="LEFT"/>report TEXT NOT NULL<BR ALIGN="LEFT"/>report_sha256 TEXT NOT NULL<BR ALIGN="LEFT"/>reviewer TEXT NOT NULL<BR ALIGN="LEFT"/>recorded_at REAL NOT NULL</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
jobs [id="06-registry-data-jobs", label=<<B>jobs</B><BR/><FONT POINT-SIZE="10">id INTEGER PRIMARY KEY<BR ALIGN="LEFT"/>site_id TEXT NOT NULL REFERENCES sites(id)<BR ALIGN="LEFT"/>url TEXT NOT NULL<BR ALIGN="LEFT"/>state TEXT NOT NULL DEFAULT &#x27;queued&#x27;<BR ALIGN="LEFT"/>attempts INTEGER NOT NULL DEFAULT 0<BR ALIGN="LEFT"/>due REAL NOT NULL DEFAULT 0<BR ALIGN="LEFT"/>lease_until REAL<BR ALIGN="LEFT"/>owner TEXT<BR ALIGN="LEFT"/>error TEXT<BR ALIGN="LEFT"/>UNIQUE(site_id,url)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#65758b">registry.py:24</FONT>>, fillcolor="#eaf6f1", color="#478570", tooltip="src/gov_mcp/knowledge/registry.py:KnowledgeStore.__init__"];
sites -> documents [label="FK", style="solid"];
