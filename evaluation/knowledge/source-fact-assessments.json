            "value": "2021-10-01"
          },
          {
            "id": "NAT-ID-MATERIALS",
            "summary": "本条将申领、换领、补领并列后规定交验户口簿；不简化成只针对首次申领。",
            "evidence": {
              "revision": "rev-cc5526f72436ae807a3f32f0",
              "original_sha256": "ddb852a3853567db2007b7668f5f0e412c6f59b2fb8a44d124c2c0beb65192d3",
              "locator": "第七十八条",
              "quote": "公民申领、换领、补领居民身份证的，应当填写《居民身份证申领登记表》，交验居民户口簿",
              "start": 6,
              "end": 47,
              "quote_sha256": "6c5d196fdc0e0189c7e4a6c540e49df03608830854496c68f3dfb2731983b79c"
            },
            "scope": "within_archived_source_text_only",
            "current_applicability": "unknown",
            "source_branches": [
              "申领",
              "换领",
              "补领"
            ],
            "material": "居民户口簿"
          },
          {
            "id": "NAT-SHARED-PAPER",
            "summary": "具备材料共享确认条件时，原文规定逐步取消纸质材料；不是无条件免交全部材料。",
            "evidence": {
              "revision": "rev-cc5526f72436ae807a3f32f0",
              "original_sha256": "ddb852a3853567db2007b7668f5f0e412c6f59b2fb8a44d124c2c0beb65192d3",
              "locator": "第十二条",
              "quote": "在办理户口、居民身份证业务过程中，能够通过数据共享、电子证照调用等方式实现对政府部门核发的材料予以确认的，应逐步取消纸质材料",
              "start": 128,
              "end": 190,
              "quote_sha256": "c26fa1f58f987afa286be3d6ad5f337c88df14ef4d8f1d21fba345280e09ed65"
            },
            "scope": "within_archived_source_text_only",
