        "facts": [
          {
            "id": "NAT-COMMENCEMENT",
            "summary": "该文件正文第97条明示的施行日",
            "evidence": {
              "revision": "rev-cc5526f72436ae807a3f32f0",
              "original_sha256": "ddb852a3853567db2007b7668f5f0e412c6f59b2fb8a44d124c2c0beb65192d3",
              "locator": "第九十七条",
              "quote": "本规范自2021年10月1日起施行",
              "start": 6,
              "end": 23,
              "quote_sha256": "f3cca6af3ea7fce1082e82efd86b8045a8d8df05f27991ad33978893f79ee635"
